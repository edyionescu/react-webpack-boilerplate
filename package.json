{
  "name": "react-webpack-boilerplate",
  "version": "1.0.0",
  "description": "React Webpack Boilerplate",
  "main": "index.js",
  "scripts": {
    "build": "webpack --config webpack.config.production.js",
    "dev": "webpack-dev-server --open --config webpack.config.development.js",
    "test": "jest",
    "format": "pretty-quick",
    "lint": "eslint ./"
  },
  "keywords": [
    "boilerplate",
    "starter",
    "react",
    "webpack",
    "babel",
    "jest",
    "prettier",
    "eslint"
  ],
  "author": "Edy Ionescu <errorsmith@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/errorsmith/react-webpack-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/errorsmith/react-webpack-boilerplate/issues"
  },
  "homepage": "https://github.com/errorsmith/react-webpack-boilerplate#readme",
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "react-refresh": "^0.18.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.109.2",
    "webpack-bundle-analyzer": "^5.3.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.6",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run format -- --staged && npm run lint && npm test"
    }
  }
}
